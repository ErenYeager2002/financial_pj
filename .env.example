# 平台
FINANCIAL_APP_NAME=财务 Skill 运行平台
FINANCIAL_ENV=development
# 默认只在本机监听；需要同一局域网试用时，显式改为 0.0.0.0 并先完成防火墙与身份认证评估。
FINANCIAL_HOST=127.0.0.1
FINANCIAL_DATABASE_URL=sqlite:///D:/BESTEASY/financial_pj/data/financial.db
FINANCIAL_MAX_UPLOAD_MB=100

# Compose 正式部署入口。默认值只用于本机受限试用。
PLATFORM_PUBLIC_ORIGIN=https://localhost:8443
PLATFORM_HOST=localhost
PLATFORM_BIND_ADDRESS=127.0.0.1
PLATFORM_HTTPS_PORT=8443
CADDYFILE_PATH=D:/BESTEASY/financial_pj/deploy/production/Caddyfile
PLATFORM_TLS_DIR=D:/BESTEASY/financial_pj/deploy/production/tls

# 会话与认证
# 生产环境（FINANCIAL_ENV=production）必须设置 FINANCIAL_SESSION_COOKIE_SECURE=true，
# 否则平台会在启动时拒绝运行（要求 HTTPS）。
FINANCIAL_SESSION_COOKIE=financial_session
FINANCIAL_SESSION_MAX_AGE_SECONDS=28800
FINANCIAL_SESSION_COOKIE_SECURE=false
FINANCIAL_SESSION_COOKIE_SAMESITE=lax
FINANCIAL_LOGIN_FAILURE_LIMIT=5
FINANCIAL_LOGIN_LOCKOUT_SECONDS=300
# 首次启动管理员的登录名与密码；不设置密码时自动生成并写入 data/initial_admin_password.txt
# （首次修改密码后该文件会被删除）。管理员使用独立 UUID，不继承历史演示数据。
FINANCIAL_BOOTSTRAP_ADMIN_USERNAME=admin
# FINANCIAL_BOOTSTRAP_ADMIN_PASSWORD=
# 可选：CSRF 来源白名单（逗号分隔），默认从请求 Host 推导同源。
# FINANCIAL_TRUSTED_ORIGINS=http://127.0.0.1:8000,https://finance.example.com

# Clerk 身份桥接。迁移前保持 session；完成管理员 Clerk ID 绑定后改为 hybrid，
# 新前端验收完成后正式环境再改为 clerk。
FINANCIAL_AUTH_MODE=session
# Clerk Session Token 的 iss，例如 https://example.clerk.accounts.dev
# FINANCIAL_CLERK_ISSUER=
# 可选：不配置时使用 <issuer>/.well-known/jwks.json
# FINANCIAL_CLERK_JWKS_URL=
# 允许的前端来源（校验 JWT azp，逗号分隔；生产环境启用 Clerk 时必须配置）
# FINANCIAL_CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# 可选 audience；仅在 Clerk Token 配置了 aud 时填写
# FINANCIAL_CLERK_AUDIENCE=

# 智云只允许真实 HTTPS FQDN 和 443 端口。没有正式域名时保持为空，
# ar-hexiao-daily 必须继续 disabled；禁止填写 IP、Hosts 别名或通配符。
FINANCIAL_NETWORK_POLICY_MODE=strict
FINANCIAL_EGRESS_PROXY_TARGETS=
FINANCIAL_EGRESS_PROXY_ALLOWLIST=
FINANCIAL_ZHIYUN_BASE_URL=

# 可选：额外扫描现有 finance-skills 中带 tool.yaml 的 Skill
# FINANCIAL_EXTERNAL_SKILL_DIR=D:/BESTEASY/finance-skills/skills

# 千问 OpenAI-Compatible 参数解析（不配置时使用本地规则和表单）
FINANCIAL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FINANCIAL_LLM_API_KEY=
FINANCIAL_LLM_MODEL=qwen3.7-plus

# Worker
# 按池启动独立 Worker。RPA 默认不开启；启用时追加 rpa:1。
FINANCIAL_WORKER_COUNTS=python:2,http:2,workflow:2
# FINANCIAL_WORKER_COUNTS=python:2,http:2,workflow:2,rpa:1
FINANCIAL_QUEUE_POLL_SECONDS=1
FINANCIAL_WORKER_LEASE_SECONDS=60
FINANCIAL_WORKER_HEARTBEAT_SECONDS=15
FINANCIAL_WORKER_MAX_ATTEMPTS=2
