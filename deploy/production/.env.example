FINANCIAL_PLATFORM_DIR=D:/BESTEASY/financial_pj
NEXT_BUILD_CONTEXT=D:/BESTEASY/financial_pj
NEXT_DOCKERFILE=web/Dockerfile.monorepo
# 生产默认使用 Pi Agent；如需兼容旧任务，可显式设置 AGENT_RUNTIME=legacy。
AGENT_RUNTIME=pi
AGENT_RUNTIME_PI_USERS=
AGENT_RUNTIME_FALLBACK=legacy
FINANCIAL_AR_HEXIAO_EXECUTION_ENABLED=false
FINANCIAL_TASK_DISCOVERY_ENABLED=false
FINANCIAL_TASK_DISCOVERY_HOLIDAYS=
FINANCIAL_PI_HARNESS_TOKEN=replace-with-random-internal-token
FINANCIAL_DATA_DIR=D:/BESTEASY/financial_pj/data
POSTGRES_PASSWORD=replace-with-random-secret
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace
CLERK_SECRET_KEY=sk_test_replace
FINANCIAL_AUTH_MODE=clerk
FINANCIAL_CLERK_ISSUER=https://example.clerk.accounts.dev
FINANCIAL_CLERK_AUTHORIZED_PARTIES=https://localhost:8443
FINANCIAL_TRUSTED_ORIGINS=https://localhost:8443
PLATFORM_PUBLIC_ORIGIN=https://localhost:8443
PLATFORM_HOST=localhost
PLATFORM_BIND_ADDRESS=127.0.0.1
PLATFORM_HTTPS_PORT=8443
CADDYFILE_PATH=D:/BESTEASY/financial_pj/deploy/production/Caddyfile
PLATFORM_TLS_DIR=D:/BESTEASY/financial_pj/deploy/production/tls
# 没有真实智云 HTTPS FQDN 时保持以下两项为空。
FINANCIAL_NETWORK_POLICY_MODE=strict
FINANCIAL_EGRESS_PROXY_TARGETS=
FINANCIAL_EGRESS_PROXY_ALLOWLIST=
FINANCIAL_ZHIYUN_BASE_URL=
