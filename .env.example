# 平台
FINANCIAL_APP_NAME=财务 Skill 运行平台
FINANCIAL_ENV=development
FINANCIAL_DATABASE_URL=sqlite:///D:/BESTEASY/financial_pj/data/financial.db
FINANCIAL_MAX_UPLOAD_MB=100

# 可选：额外扫描现有 finance-skills 中带 tool.yaml 的 Skill
# FINANCIAL_EXTERNAL_SKILL_DIR=D:/BESTEASY/finance-skills/skills

# 千问 OpenAI-Compatible 参数解析（不配置时使用本地规则和表单）
FINANCIAL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FINANCIAL_LLM_API_KEY=
FINANCIAL_LLM_MODEL=qwen3.7-plus

# Worker
FINANCIAL_WORKER_POOLS=python,http
# 在已配置受控浏览器和凭据保管后，才加入 rpa：
# FINANCIAL_WORKER_POOLS=python,http,rpa
FINANCIAL_QUEUE_POLL_SECONDS=1
