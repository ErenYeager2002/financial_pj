{
  "name": "financial-platform-web",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "Kiran",
    "url": "https://github.com/Kiranism"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "contracts:generate": "openapi-typescript ../contracts/financial-platform.openapi.json -o src/features/platform-api/generated.ts --root-types --root-types-no-schema-prefix",
    "contracts:check": "openapi-typescript ../contracts/financial-platform.openapi.json -o src/features/platform-api/generated.ts --root-types --root-types-no-schema-prefix --check",
    "test:navigation": "node --experimental-strip-types --test tests/platform-navigation.test.ts tests/breadcrumbs.test.ts",
    "test:run-access": "node --experimental-strip-types --test tests/platform-run-access.test.ts",
    "test:platform-data": "node --experimental-strip-types --test tests/platform-data-layer.test.ts",
    "test:agent-wire": "node --experimental-strip-types --test tests/agent-wire.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && pnpm format",
    "lint:strict": "oxlint --deny-warnings",
    "format": "oxfmt --write . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "format:check": "oxfmt --check . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.47",
    "@base-ui/react": "^1.6.0",
    "@clerk/localizations": "^4.15.1",
    "@clerk/nextjs": "^7.3.5",
    "@clerk/ui": "^1.30.1",
    "@financial-platform/agent-runtime": "file:../agent-runtime",
    "@sentry/nextjs": "^10.45.0",
    "@shadcn/helpers": "^0.1.0",
    "@shadcn/react": "^0.2.1",
    "@tabler/icons-react": "^3.40.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-query-devtools": "^5.95.2",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.44",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "kbar": "^0.1.0-beta.48",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nuqs": "^2.8.9",
    "postcss": "8.5.25",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-dropzone": "^14.4.1",
    "react-markdown": "10.1.0",
    "react-responsive": "^10.0.1",
    "remark-gfm": "4.0.1",
    "sharp": "^0.35.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "typebox": "1.3.7",
    "typescript": "5.7.2",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "openapi-typescript": "7.12.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.25",
    "sharp": "^0.35.3"
  },
  "lint-staged": {
    "!(scripts)/**/*.{js,jsx,tsx,ts,css,less,scss,sass}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@10.15.1"
}
