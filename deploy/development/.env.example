# 此文件只提供键名。scripts/dev.ps1 会优先从本机生产配置复制 Clerk 配置，
# 但不会复制生产数据库和平台文件。
POSTGRES_PASSWORD=financial-dev-local-only
FINANCIAL_AUTH_MODE=session
FINANCIAL_NETWORK_POLICY_MODE=strict
FINANCIAL_EGRESS_PROXY_TARGETS=
FINANCIAL_EGRESS_PROXY_ALLOWLIST=
FINANCIAL_ZHIYUN_BASE_URL=
FINANCIAL_DEV_AR_HEXIAO_EXECUTION_ENABLED=true
FINANCIAL_DEV_TASK_DISCOVERY_ENABLED=true
FINANCIAL_TASK_DISCOVERY_HOLIDAYS=
FINANCIAL_PI_HARNESS_TOKEN=replace-with-random-internal-token
AGENT_RUNTIME=pi
AGENT_RUNTIME_PI_USERS=
AGENT_RUNTIME_FALLBACK=legacy

# Required before migration: use none only for a new empty database.
# For an existing database, replace none with its reviewed current revision.
FINANCIAL_MIGRATION_EXPECTED_REVISION=none
FINANCIAL_MIGRATION_TARGET_REVISION=f2a3b4c5d6e7
