FROM docker.m.daocloud.io/library/node:22-slim AS node
FROM financial-platform-isolated-native-runtime:20260916
USER root
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
RUN apt-get update && apt-get install -y --no-install-recommends git ripgrep fd-find curl ca-certificates && ln -s /usr/bin/fdfind /usr/local/bin/fd && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/pi && npm install --prefix /opt/pi --ignore-scripts --save-exact @earendil-works/pi-coding-agent@0.85.1 && ln -s /opt/pi/node_modules/.bin/pi /usr/local/bin/pi
COPY deployment/pi_runtime_server.py /opt/platform/pi_runtime_server.py
COPY deployment/pi_session_tracking.ts /opt/platform/pi_session_tracking.ts
ENV HOME=/home/agent PI_TELEMETRY=0 PI_SKIP_VERSION_CHECK=1
RUN mkdir -p /home/agent /workspace && chown 10001:10001 /home/agent /workspace
USER 10001:10001
WORKDIR /workspace

COPY deployment/pi_jobs.py /opt/platform/pi_jobs.py
COPY deployment/pi_jobs_extension.ts /opt/platform/pi_jobs_extension.ts

COPY deployment/pi_browser.py /opt/platform/pi_browser.py
COPY deployment/pi_browser_extension.ts /opt/platform/pi_browser_extension.ts
